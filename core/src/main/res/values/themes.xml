<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Zamovie" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowEnterTransition">@android:transition/explode</item>
        <item name="android:windowExitTransition">@android:transition/explode</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="backgroundColor">@color/background</item>

        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/onPrimary</item>

        <item name="android:fontFamily">@font/poppinsregular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/onBackground</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:scrollbars">none</item>
    </style>

    <style name="Theme.Zamovie" parent="Base.Theme.Zamovie" />

    <style name="TextTitle">
        <item name="android:textSize">20sp</item>
        <item name="fontFamily">@font/poppinsmedium</item>
    </style>

    <style name="TextHeading1" parent="TextTitle">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextHeading2" parent="TextTitle">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextHeading3" parent="TextTitle">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextDescription">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/grey</item>
    </style>

    <style name="CustomProgressBar">
        <item name="android:progressTint">@color/primary</item>
    </style>
</resources>